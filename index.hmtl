    {x: 1880, y: 410, collected:false},

    {x: 2160, y: 340, collected:false},
    {x: 2470, y: 410, collected:false},
    {x: 2780, y: 310, collected:false}
];


// ===============================
// ENEMIES
// ===============================

const enemies = [
    {x: 400, y: 355, w: 35, h:35, vx:2, alive:true},
    {x: 850, y: 315, w:35, h:35, vx:2, alive:true},
    {x: 1400, y:365, w:35, h:35, vx:2, alive:true},
    {x: 190
